# AXIO - Real Analysis Theorem Proving System
# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application Settings
APP_MODE=production
APP_DEBUG=false
APP_URL=https://axio-ai-tutor.onrender.com

# Backend Configuration
BACKEND_URL=/backend/api/
FRONTEND_URL=/frontend/

# Database Configuration
DATABASE_MODE=demo
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=lean4_ai_db
DATABASE_USER=root
DATABASE_PASSWORD=your_database_password
DATABASE_URL=mysql://user:password@localhost:3306/lean4_ai_db

# DeepSeek AI Configuration
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_TEMPERATURE=0.7

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=backend/logs/app.log

# CORS Configuration
CORS_ALLOW_ORIGIN=*
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization

# Performance
OUTPUT_BUFFERING=On
MEMORY_LIMIT=256M
MAX_EXECUTION_TIME=300
